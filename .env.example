# Copie para .env se quiser sobrescrever. Não commite o .env.
# O padrão já roda offline: provedor fake, sem chave.

# fake (padrão, CI), gemini ou openai. O SDK real só é importado na primeira chamada.
EMBEDDING_PROVIDER=fake

# Obrigatória só se EMBEDDING_PROVIDER=gemini. Deixe vazio no git.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Obrigatórias só se EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# fixed, fixed_overlap, sentence_paragraph ou semantic.
# fixed ignora overlap. fixed_overlap exige overlap >= 1.
CHUNK_STRATEGY=fixed
# chars ou tokens. tokens só vale para fixed e fixed_overlap.
CHUNK_UNIT=chars
CHUNK_SIZE=120
CHUNK_OVERLAP=0
# Quebra semântica quando o cosseno entre frases vizinhas fica abaixo deste valor.
SEMANTIC_SIMILARITY_THRESHOLD=0.5

TOP_K=3
# Dimensão do embedder fake. Ignorada pelos provedores reais.
EMBEDDING_DIMENSION=64

CORPUS_PATH=data/placeholder
QUERIES_PATH=data/placeholder/queries.jsonl
